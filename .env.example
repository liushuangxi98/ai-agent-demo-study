# 百炼问答和 Embedding 共用这一份密钥、兼容接口地址。
LLM_API_KEY=
LLM_BASE_URL=https://<业务空间ID>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
EMBEDDING_MODEL=text-embedding-v4

# 项目启动时自动创建 MYSQL_DATABASE、对话表和结构化记忆表。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=agent_demo

# 单人学习使用固定 ID；新建会话不改变它，个人记忆因此可以跨会话共享。
USER_ID=local_user

# 回答完成后，主问答最后一次返回的输入加输出 token 严格大于阈值才压缩。
CONTEXT_TOKEN_BUDGET=50000
# 每次压缩保留最近完整问答，此后原文继续增长；应用不限制摘要长度。
SUMMARY_KEEP_TURNS=6
RAG_TOP_K=3
RAG_MAX_DISTANCE=0.8

# 回答前检查一次，有明确问题才重写一次；会额外调用模型。修改后重启网页。
REFLECTION_ENABLED=false
